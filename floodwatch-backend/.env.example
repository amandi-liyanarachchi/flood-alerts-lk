# Copy to .env and edit. Never commit .env.

ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ADMIN_TOKEN=change-me-too

# Laptop / no Docker (the default):
DATABASE_URL=sqlite:///./floodwatch.db
# Docker Compose overrides this automatically with:
# DATABASE_URL=postgresql+psycopg://floodwatch:floodwatch@db:5432/floodwatch

# --- region and aggregation (DESIGN.md sec 4) --------------------------
GEOHASH_PRECISION=5
CROWD_WINDOW_MINUTES=60
CROWD_MIN_RESPONDENTS=5
CROWD_YES_RATIO=0.75

# --- ingestion ---------------------------------------------------------
INGEST_ENABLED=true
INGEST_GAUGES_MINUTES=10
INGEST_RAINFALL_MINUTES=60
RISK_EVALUATE_MINUTES=10

# --- push --------------------------------------------------------------
# Leave unset to disable push. Alerts still work via GET /alerts/active.
# FIREBASE_CREDENTIALS_FILE=/srv/secrets/firebase-service-account.json

# --- retention (DESIGN.md sec 7) ---------------------------------------
RETENTION_LOCATIONS_DAYS=90
RETENTION_FEEDBACK_DAYS=730

CONSENT_NOTICE_VERSION=2026-08-v1
